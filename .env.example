# ==========================================================================
# Mylapore Bites — environment template
#
#   cp .env.example .env      then fill in.      NEVER commit .env
#
# Everything the platform reads is listed here. The API validates this file
# at boot (apps/api/src/config/env.schema.ts) and refuses to start if a
# required value is missing — a missing secret stops the process rather than
# surfacing as `undefined` mid-checkout.
#
# Generate secrets:
#   openssl rand -base64 32
#   openssl genpkey -algorithm RSA -out jwt.key -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# ==========================================================================

# --------------------------------------------------------------- RUNTIME
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=0.1.0

# -------------------------------------------------------------- DATABASE
# Matches docker/docker-compose.yml for local development.
DATABASE_URL=postgresql://mylaporebites:localdev@localhost:5432/mylaporebites?schema=public
DB_POOL_SIZE=15

POSTGRES_USER=mylaporebites
POSTGRES_PASSWORD=localdev
POSTGRES_DB=mylaporebites

# ----------------------------------------------------------------- REDIS
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=localdev
WORKER_CONCURRENCY=5

# --------------------------------------------------------------- SECRETS
# RS256 keypair, PEM. In .env put the whole key on one line with \n escapes.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=
REVALIDATE_SECRET=

# --------------------------------------------------------------- ORIGINS
# Strict CORS allowlist. Never a wildcard with credentials.
STOREFRONT_IN_ORIGIN=http://localhost:3000
STOREFRONT_UK_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Hostnames, used by Caddy in production.
STOREFRONT_IN_DOMAIN=mylaporebites.com
STOREFRONT_UK_DOMAIN=mylaporebites.co.uk
ADMIN_DOMAIN=admin.mylaporebites.com
API_DOMAIN=api.mylaporebites.com
ACME_EMAIL=ops@mylaporebites.com

# ------------------------------------------------------------------- OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_WHATSAPP_FALLBACK_SECONDS=30

# -------------------------------------------------------------- PRE-ORDER
# How long a delivery-date capacity hold survives before the worker releases it.
CAPACITY_HOLD_TTL_MINUTES=15

# --------------------------------------------------------------- WHATSAPP
# Meta WhatsApp Cloud API. Leave blank in development — the OTP falls back to
# SMS, and with SMS_PROVIDER=console the code is printed to the API log and
# returned as `devCode`, so no Meta account is needed to sign in locally.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved template NAMES only. Wording lives in Meta Business Manager.
WHATSAPP_TEMPLATE_OTP=mb_login_code
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=mb_order_confirmed
WHATSAPP_TEMPLATE_PRODUCTION_STARTED=mb_production_started
WHATSAPP_TEMPLATE_ORDER_PACKED=mb_order_packed
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=mb_out_for_delivery
WHATSAPP_TEMPLATE_DELIVERED=mb_order_delivered
WHATSAPP_TEMPLATE_REVIEW_REQUEST=mb_review_request

# -------------------------------------------------------------------- SMS
SMS_PROVIDER=console          # console | msg91 | twilio
SMS_API_KEY=
SMS_SENDER_ID=MYLBTS
SMS_TEMPLATE_ID_OTP=          # DLT template id — required for India

# ------------------------------------------------------------------ EMAIL
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Mylapore Bites <orders@mylaporebites.com>"
EMAIL_REPLY_TO=support@mylaporebites.com

# --------------------------------------------------------- PAYMENTS · INDIA
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------ PAYMENTS · UK
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- STORAGE
# MinIO locally (docker compose), Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=mylaporebites-media
S3_ACCESS_KEY_ID=mylaporebites
S3_SECRET_ACCESS_KEY=localdev123
S3_PUBLIC_BASE_URL=http://localhost:9000/mylaporebites-media

# ---------------------------------------------------------------- BACKUPS
BACKUP_CRON=0 18 * * *                 # 18:00 UTC = 23:30 IST
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_ENCRYPTION_KEY=                 # STORE THIS OFF-SERVER
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=mylaporebites-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_HEALTHCHECK_URL=

# ---------------------------------------------------------- OBSERVABILITY
SENTRY_DSN=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------- FRONTEND (web)
API_INTERNAL_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/mylaporebites-media

# ------------------------------------------------------- SEED (bootstrap only)
# Read ONLY by the seed script to create the first market and admin user.
# After seeding, all of this is edited in Admin. Nothing here is read at runtime.
SEED_DEFAULT_MARKET_CODE=IN
SEED_DEFAULT_CURRENCY=INR
SEED_DEFAULT_TIMEZONE=Asia/Kolkata
SEED_DEFAULT_WAREHOUSE_NAME=Mylapore Production Centre
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# -------------------------------------------------------------- DEPLOYMENT
IMAGE_REGISTRY=ghcr.io/<org>
IMAGE_TAG=latest
